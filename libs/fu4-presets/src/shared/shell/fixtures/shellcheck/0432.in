BASE_SHA="$(git rev-parse HEAD^)"
if [ -n "$PUSH_BEFORE_SHA" ] && [ "$PUSH_BEFORE_SHA" != "$BASE_SHA" ] \
  && [ "$PUSH_BEFORE_SHA" != "0000000000000000000000000000000000000000" ] \
  && git fetch --no-tags --depth=1 origin "$PUSH_BEFORE_SHA"; then
  BASE_SHA="$PUSH_BEFORE_SHA"
fi
git reset "$BASE_SHA" --hard
./tools/nix/list-requisites.sh > requisites-____________________-before.list
