{
  "name": "@r_masseater/fu4-presets",
  "version": "0.1.0",
  "description": "The official fu4 rules for GitHub Actions: actionlint, shellcheck and zizmor checks in TypeScript, grouped into presets you pick per concern.",
  "keywords": [
    "actionlint",
    "fu4",
    "github-actions",
    "shellcheck",
    "tanstack-intent",
    "zizmor"
  ],
  "homepage": "https://github.com/masseater/masseater.dev/tree/main/libs/fu4-presets#readme",
  "bugs": {
    "url": "https://github.com/masseater/masseater.dev/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/masseater.dev.git",
    "directory": "libs/fu4-presets"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:"
  },
  "devDependencies": {
    "@r_masseater/fu4": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "minimatch": "catalog:",
    "vite-plus": "catalog:stack",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "@r_masseater/fu4": "workspace:^",
    "effect": "^4.1.2"
  },
  "engines": {
    "node": ">=26"
  }
}
