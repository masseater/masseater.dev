{
  "name": "@r_masseater/msch",
  "version": "0.3.0",
  "description": "masseater's check policy: points every finite value set and object shape at its one owner, and ships the oxlint preset of plugins and rules.",
  "keywords": [
    "lint",
    "oxlint",
    "vite-plus"
  ],
  "homepage": "https://github.com/masseater/masseater.dev/tree/main/libs/msch#readme",
  "bugs": {
    "url": "https://github.com/masseater/masseater.dev/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/masseater.dev.git",
    "directory": "libs/msch"
  },
  "bin": {
    "msch": "./src/cli.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./cli": "./src/cli.ts",
    "./decision-rules": "./src/lint/decision-rules.ts",
    "./lint": "./src/lint/index.ts",
    "./oxlint": "./src/oxlint.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "msch": "./dist/cli.mjs"
    },
    "exports": {
      "./cli": "./dist/cli.mjs",
      "./decision-rules": {
        "types": "./dist/decision-rules.d.mts",
        "default": "./dist/decision-rules.mjs"
      },
      "./lint": {
        "types": "./dist/lint.d.mts",
        "default": "./dist/lint.mjs"
      },
      "./oxlint": {
        "types": "./dist/oxlint.d.mts",
        "default": "./dist/oxlint.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@html-eslint/eslint-plugin-react": "catalog:",
    "@r_masseater/oxlint-plugin-decision": "workspace:*",
    "@r_masseater/oxlint-typed-rules": "catalog:",
    "@shadcn/lint": "catalog:",
    "effect": "catalog:stack",
    "eslint-plugin-baseline-js": "catalog:",
    "eslint-plugin-no-comments": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "oxlint-plugin-eslint": "catalog:",
    "typescript": "catalog:stack",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@r_masseater/vitest-otlp": "workspace:*",
    "@types/node": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "vite-plus": ">=1.5.0"
  },
  "engines": {
    "node": ">=26"
  }
}
