{
  "name": "@r_masseater/msch",
  "version": "0.50.0",
  "description": "masseater's check policy: points every finite value set and object shape at its one owner, and ships the oxlint preset of plugins and rules.",
  "keywords": [
    "lint",
    "oxlint",
    "tanstack-intent",
    "vite-plus"
  ],
  "homepage": "https://github.com/masseater/masseater.dev/tree/main/libs/msch#readme",
  "bugs": {
    "url": "https://github.com/masseater/masseater.dev/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/masseater.dev.git",
    "directory": "libs/msch"
  },
  "bin": {
    "msch": "./bin/msch.ts",
    "msch-changed": "./bin/msch-changed.ts",
    "msch-exits": "./bin/msch-exits.ts",
    "msch-publish": "./bin/msch-publish.ts"
  },
  "files": [
    "dist",
    "skills/msch-checks",
    "skills/publishing",
    "skills/repository-config",
    "skills/workspace-settings",
    "src/app/vite.d.ts"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#package.json": "./package.json"
  },
  "exports": {
    "./cli": "./bin/msch.ts",
    "./cargo-inputs": "./src/features/derive-cargo-inputs/index.ts",
    "./locked-inputs": "./src/features/derive-locked-inputs/index.ts",
    "./config": "./src/app/repository-config.ts",
    "./decision-rules": "./src/app/decision-rules.ts",
    "./lint-rules": "./src/features/define-lint-rules/index.ts",
    "./lint": "./src/features/define-lint-preset/index.ts",
    "./oxlint": "./src/app/oxlint.ts",
    "./vite": {
      "types": "./src/app/vite.d.ts"
    },
    "./workspace-settings": "./src/features/build-workspace-settings/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "msch": "./dist/cli.mjs",
      "msch-changed": "./dist/changed.mjs",
      "msch-exits": "./dist/exits.mjs",
      "msch-publish": "./dist/publish.mjs"
    },
    "exports": {
      "./cli": "./dist/cli.mjs",
      "./cargo-inputs": {
        "types": "./dist/cargo-inputs.d.mts",
        "default": "./dist/cargo-inputs.mjs"
      },
      "./locked-inputs": {
        "types": "./dist/locked-inputs.d.mts",
        "default": "./dist/locked-inputs.mjs"
      },
      "./config": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "./decision-rules": {
        "types": "./dist/decision-rules.d.mts",
        "default": "./dist/decision-rules.mjs"
      },
      "./lint-rules": {
        "types": "./dist/lint-rules.d.mts",
        "default": "./dist/lint-rules.mjs"
      },
      "./lint": {
        "types": "./dist/lint.d.mts",
        "default": "./dist/lint.mjs"
      },
      "./oxlint": {
        "types": "./dist/oxlint.d.mts",
        "default": "./dist/oxlint.mjs"
      },
      "./workspace-settings": {
        "types": "./dist/workspace-settings.d.mts",
        "default": "./dist/workspace-settings.mjs"
      },
      "./vite": {
        "types": "./src/app/vite.d.ts"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@html-eslint/eslint-plugin-react": "catalog:",
    "@pnpm/deps.path": "catalog:",
    "@pnpm/lockfile.fs": "catalog:",
    "@pnpm/logger": "catalog:",
    "@pnpm/workspace.projects-reader": "catalog:",
    "@pnpm/workspace.workspace-manifest-reader": "catalog:",
    "@pnpm/workspace.workspace-manifest-writer": "catalog:",
    "@r_masseater/fu4": "workspace:*",
    "@r_masseater/fu4-presets": "workspace:*",
    "@r_masseater/h56m": "workspace:*",
    "@r_masseater/h56m-presets": "workspace:*",
    "@r_masseater/oxlint-plugin-decision": "workspace:*",
    "@r_masseater/oxlint-typed-rules": "catalog:",
    "@r_masseater/textlint-rule-preset-ja": "workspace:*",
    "@r_masseater/vite-plus-adopt": "catalog:",
    "@r_masseater/wism": "workspace:*",
    "@r_masseater/wism-presets": "workspace:*",
    "@r_masseater/y8": "workspace:*",
    "@r_masseater/y8-presets": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@tanstack/intent": "catalog:",
    "@textlint-ja/textlint-rule-preset-ai-writing": "catalog:",
    "@vscode/tree-sitter-wasm": "catalog:",
    "dockerfile-ast": "catalog:",
    "domhandler": "catalog:",
    "eslint-plugin-baseline-js": "catalog:",
    "eslint-plugin-no-comments": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "htmlparser2": "catalog:",
    "oxlint-plugin-eslint": "catalog:",
    "semver": "catalog:",
    "sql-parser-cst": "catalog:",
    "textlint-rule-preset-ja-technical-writing": "catalog:",
    "toml-eslint-parser": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@effect/vitest": "catalog:",
    "@masseater.dev/github-workflow": "workspace:*",
    "@r_masseater/vitest-otlp": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "effect": "catalog:stack",
    "typescript": "catalog:stack",
    "vite": "catalog:",
    "vite-plus": "catalog:stack",
    "wordnet-db": "catalog:"
  },
  "peerDependencies": {
    "@effect/tsgo": ">=0.67.5",
    "effect": "^4.1.2",
    "typescript": ">=7.1.0-beta",
    "vite": "*",
    "vite-plus": ">=1.5.0"
  },
  "engines": {
    "node": "v26.13.1"
  }
}
