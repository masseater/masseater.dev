{
  "name": "@r_masseater/i68-presets",
  "version": "0.1.0",
  "description": "The official i68 rule presets for .fumx songs, one per concern: pop (key, range, leaps, breath), voicing (clashes, low interval limits, crowded low mids, chord placement, voice leaps), classical (parallel fifths and octaves, unresolved dissonance), progressions (famous chord progressions) and bach (chord changes compared with the Bach chorales).",
  "keywords": [
    "fumx",
    "i68",
    "music-theory",
    "preset",
    "tanstack-intent",
    "voicing"
  ],
  "homepage": "https://github.com/masseater/masseater.dev/tree/main/libs/i68-presets#readme",
  "bugs": {
    "url": "https://github.com/masseater/masseater.dev/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/masseater.dev.git",
    "directory": "libs/i68-presets"
  },
  "files": [
    "LICENSE",
    "dist",
    "skills/use-presets"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@r_masseater/fumx-parser": "workspace:*",
    "tonal": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@masseater.dev/song-format": "workspace:*",
    "@r_masseater/i68": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "verovio": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "@r_masseater/i68": "workspace:^",
    "effect": "^4.1.2"
  },
  "engines": {
    "node": "v26.13.1"
  }
}
