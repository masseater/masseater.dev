{
  "name": "@r_masseater/tsrs-effect",
  "version": "7.1.0-beta.tsrs2.effect.0.70.0",
  "description": "tsrs, the Rust port of TypeScript 7, built with the Effect language service, for the tsrs versions that @effect/tsgo does not ship yet. Each per-platform package replaces the matching @tsrs platform package.",
  "keywords": [
    "effect",
    "tsrs",
    "typescript"
  ],
  "homepage": "https://github.com/masseater/masseater.dev/tree/main/libs/tsrs-effect#readme",
  "bugs": {
    "url": "https://github.com/masseater/masseater.dev/issues"
  },
  "license": "Apache-2.0 AND MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/masseater.dev.git",
    "directory": "libs/tsrs-effect"
  },
  "files": [
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {},
  "devDependencies": {
    "@masseater.dev/github-workflow": "workspace:*",
    "@masseater.dev/node-main": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "engines": {
    "node": ">=26"
  },
  "native": {
    "binary": "tsrs",
    "targets": [
      "linux-x64-gnu",
      "win32-x64-msvc"
    ],
    "archive": true
  },
  "upstream": {
    "effect": "@effect/tsgo@0.70.0",
    "tsrs": "v7.1.0-beta.tsrs2",
    "skip": [
      "160-bolt-extra-workload.patch"
    ]
  }
}
