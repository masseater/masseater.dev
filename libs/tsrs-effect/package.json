{
  "name": "@masseater.dev/tsrs-effect",
  "version": "0.0.0",
  "private": true,
  "description": "Builds tsrs with the Effect language service for the tsrs version Vite+ bundles, and runs commands with TSRS_BINARY pointed at that build.",
  "bin": {
    "tsrs-effect": "./bin/launch.ts"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@masseater.dev/github-workflow": "workspace:*",
    "@masseater.dev/node-main": "workspace:*",
    "effect": "catalog:stack"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "upstream": {
    "effect": "@effect/tsgo@0.73.2",
    "tsrs": "v7.1.0-beta.tsrs2",
    "skip": [
      "160-bolt-extra-workload.patch"
    ],
    "targets": [
      "linux-x64-gnu",
      "win32-x64-msvc"
    ]
  }
}
