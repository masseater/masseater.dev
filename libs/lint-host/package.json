{
  "name": "@masseater.dev/lint-host",
  "version": "0.0.0",
  "private": true,
  "description": "Runs a Rust linter from Node.js: builds and loads its napi addon, reads its vite.config.ts section and the files git tracks, resolves rule settings and passes the trace on.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/masseater.dev.git",
    "directory": "libs/lint-host"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./vite": "./src/app/vite.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@r_masseater/vitest-otlp": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "effect": "^4.1.2",
    "vite": "*",
    "vite-plus": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": "v26.13.1"
  }
}
