{
  "name": "@r_masseater/lint-host",
  "version": "0.1.0",
  "description": "Runs a Rust linter from Node.js: builds and loads its napi addon, reads its vite.config.ts section and the files git tracks, resolves rule settings and passes the trace on.",
  "keywords": [
    "lint",
    "napi",
    "rust",
    "tanstack-intent",
    "vite-plus"
  ],
  "homepage": "https://github.com/masseater/masseater.dev/tree/main/libs/lint-host#readme",
  "bugs": {
    "url": "https://github.com/masseater/masseater.dev/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/masseater.dev.git",
    "directory": "libs/lint-host"
  },
  "files": [
    "LICENSE",
    "dist",
    "skills/host-rust-linter"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./vite": "./src/app/vite.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./vite": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@r_masseater/vitest-otlp": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "effect": "^4.1.2",
    "vite": "*",
    "vite-plus": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  }
}
