{
  "name": "@masseater.dev/song-format",
  "version": "0.0.0",
  "private": true,
  "description": "The .fumx song format: TypeScript imports, language server, MIDI conversion and the song-report command.",
  "bin": {
    "als-to-fumx": "./bin/als-to-fumx.ts",
    "fumx-language-server": "./bin/fumx-language-server.ts",
    "midi-to-fumx": "./bin/midi-to-fumx.ts",
    "song-report": "./bin/song-report.ts"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./convert-midi": "./src/features/convert-midi/index.ts",
    "./vite": "./src/app/vite.ts"
  },
  "dependencies": {
    "@effect/platform-node-shared": "catalog:",
    "@masseater.dev/node-main": "workspace:*",
    "@r_masseater/fumx-parser": "workspace:*",
    "ableton-als": "catalog:",
    "effect": "catalog:stack",
    "fast-xml-parser": "catalog:",
    "langium": "catalog:",
    "mapped-import": "workspace:*",
    "midi-file": "catalog:",
    "tonal": "catalog:",
    "ts-content-mapper": "0.1.1",
    "vscode-languageserver": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@masseater.dev/song-format": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "typescript": {
    "contentMapper": {
      "compilerOptions": [],
      "dynamicConfig": false,
      "exec": [
        "node",
        "src/app/mapper.ts"
      ]
    }
  }
}
