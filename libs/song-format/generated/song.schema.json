{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "meter": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "bar": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Bar number, counted from 1."
            },
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "denominator": {
              "type": "number",
              "enum": [
                1,
                2,
                4,
                8,
                16,
                32
              ]
            }
          },
          "required": [
            "bar",
            "numerator",
            "denominator"
          ],
          "additionalProperties": true,
          "description": "The meter from this bar on."
        }
      ],
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Bar number, counted from 1."
          },
          "numerator": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "denominator": {
            "type": "number",
            "enum": [
              1,
              2,
              4,
              8,
              16,
              32
            ]
          }
        },
        "required": [
          "bar",
          "numerator",
          "denominator"
        ],
        "additionalProperties": true,
        "description": "The meter from this bar on."
      }
    },
    "tempo": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "bar": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Bar number, counted from 1. Bar 0 is the pickup before bar 1."
            },
            "beat": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Beat in the bar, counted from 1. A beat is one unit of the meter's denominator."
            },
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 479,
              "description": "Offset inside the beat, from 0 to 479. One beat is 480 ticks."
            },
            "bpm": {
              "type": "number",
              "minimum": 20,
              "maximum": 400
            }
          },
          "required": [
            "bar",
            "beat",
            "tick",
            "bpm"
          ],
          "additionalProperties": true,
          "description": "Beats per minute from this position on."
        }
      ],
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Bar number, counted from 1. Bar 0 is the pickup before bar 1."
          },
          "beat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Beat in the bar, counted from 1. A beat is one unit of the meter's denominator."
          },
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 479,
            "description": "Offset inside the beat, from 0 to 479. One beat is 480 ticks."
          },
          "bpm": {
            "type": "number",
            "minimum": 20,
            "maximum": 400
          }
        },
        "required": [
          "bar",
          "beat",
          "tick",
          "bpm"
        ],
        "additionalProperties": true,
        "description": "Beats per minute from this position on."
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fromBar": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Bar number, counted from 1."
          },
          "toBar": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Bar number, counted from 1."
          }
        },
        "required": [
          "name",
          "fromBar",
          "toBar"
        ],
        "additionalProperties": true,
        "description": "A rehearsal mark over a range of bars, both ends included."
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Bar number, counted from 1."
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "bar",
          "label"
        ],
        "additionalProperties": true,
        "description": "A label the composer put at the start of a bar."
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "pitched"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "melody",
                  "countermelody",
                  "bass",
                  "harmony"
                ]
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "bar": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "Bar number, counted from 1. Bar 0 is the pickup before bar 1."
                    },
                    "beat": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991,
                      "description": "Beat in the bar, counted from 1. A beat is one unit of the meter's denominator."
                    },
                    "tick": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 479,
                      "description": "Offset inside the beat, from 0 to 479. One beat is 480 ticks."
                    },
                    "pitch": {
                      "type": "string",
                      "pattern": "^[A-G](?:##|#|bb|b)?(?:-1|[0-9])$",
                      "description": "Scientific pitch name with its spelling, such as C4, F#2 or Bb-1."
                    },
                    "cents": {
                      "type": "number",
                      "minimum": -50,
                      "maximum": 50,
                      "description": "Detune from the written pitch, in cents."
                    },
                    "length": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991,
                      "description": "How long the note sounds, in ticks."
                    },
                    "velocity": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1,
                      "description": "How hard the note is played, above 0 and up to 1."
                    },
                    "lyric": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The word or syllable sung on this note."
                    },
                    "bend": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "at": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991,
                            "description": "Ticks after the note starts."
                          },
                          "semitones": {
                            "type": "number",
                            "minimum": -48,
                            "maximum": 48
                          }
                        },
                        "required": [
                          "at",
                          "semitones"
                        ],
                        "additionalProperties": true,
                        "description": "The pitch offset at this point; pitch moves in a line between points."
                      }
                    }
                  },
                  "required": [
                    "bar",
                    "beat",
                    "tick",
                    "pitch",
                    "length",
                    "velocity"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "kind",
              "name",
              "role",
              "notes"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "drums"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "hits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "bar": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "Bar number, counted from 1. Bar 0 is the pickup before bar 1."
                    },
                    "beat": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991,
                      "description": "Beat in the bar, counted from 1. A beat is one unit of the meter's denominator."
                    },
                    "tick": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 479,
                      "description": "Offset inside the beat, from 0 to 479. One beat is 480 ticks."
                    },
                    "voice": {
                      "type": "string",
                      "enum": [
                        "kick",
                        "snare",
                        "side-stick",
                        "clap",
                        "closed-hihat",
                        "pedal-hihat",
                        "open-hihat",
                        "low-tom",
                        "mid-tom",
                        "high-tom",
                        "crash",
                        "ride",
                        "ride-bell",
                        "splash",
                        "china",
                        "tambourine",
                        "cowbell",
                        "shaker",
                        "high-bongo",
                        "low-bongo",
                        "high-conga",
                        "low-conga",
                        "timbale",
                        "clave",
                        "woodblock",
                        "triangle",
                        "cabasa",
                        "guiro"
                      ]
                    },
                    "velocity": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1,
                      "description": "How hard the note is played, above 0 and up to 1."
                    }
                  },
                  "required": [
                    "bar",
                    "beat",
                    "tick",
                    "voice",
                    "velocity"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "kind",
              "name",
              "hits"
            ],
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "required": [
    "title",
    "meter",
    "tempo",
    "parts"
  ],
  "additionalProperties": true,
  "title": "Song",
  "description": "What the music is: meter, tempo, and the notes of each part. Keys and chords are derived from the notes, and instruments belong to the DAW project.",
  "$defs": {}
}
