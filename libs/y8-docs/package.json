{
  "name": "@r_masseater/y8-docs",
  "version": "0.1.0",
  "description": "y8 rules for README.md, AGENTS.md and SKILL.md, with a preset that applies each to its own files.",
  "keywords": [
    "agents-md",
    "markdown",
    "readme",
    "skill-md",
    "tanstack-intent",
    "y8"
  ],
  "homepage": "https://github.com/masseater/masseater.dev/tree/main/libs/y8-docs#readme",
  "bugs": {
    "url": "https://github.com/masseater/masseater.dev/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/masseater.dev.git",
    "directory": "libs/y8-docs"
  },
  "files": [
    "LICENSE",
    "dist",
    "skills/lint-docs"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "minimatch": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@r_masseater/y8": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "@r_masseater/y8": "workspace:^",
    "effect": "^4.1.2"
  },
  "engines": {
    "node": ">=26"
  }
}
