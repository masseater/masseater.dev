{
  "extends": "../../tsconfig.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node/NodeHttpServer#make",
          "@effect/platform-node/NodeRuntime#runMain",
          "@effect/platform-node/NodeServices#layer",
          "@effect/vitest#layer",
          "effect/FileSystem#File",
          "effect/FileSystem#FileSystem",
          "effect/Path#Path",
          "effect/PlatformError#PlatformError",
          "effect/Stdio#Stdio",
          "effect/cli/Argument#String",
          "effect/cli/Command#make",
          "effect/cli/Command#run",
          "effect/cli/Command#runWith",
          "effect/cli/Command#withDescription",
          "effect/cli/Command#withSubcommands",
          "effect/cli/Flag#Literals",
          "effect/cli/Flag#String",
          "effect/cli/Flag#optional",
          "effect/cli/Flag#withDefault",
          "effect/http/FetchHttpClient#layer",
          "effect/http/Headers#get",
          "effect/http/HttpBody#HttpBodyError",
          "effect/http/HttpClient#HttpClient",
          "effect/http/HttpClient#execute",
          "effect/http/HttpClient#get",
          "effect/http/HttpClient#make",
          "effect/http/HttpClient#mapRequest",
          "effect/http/HttpClient#retryTransient",
          "effect/http/HttpClientError#HttpClientError",
          "effect/http/HttpClientRequest#HttpClientRequest",
          "effect/http/HttpClientRequest#bearerToken",
          "effect/http/HttpClientRequest#bodyJson",
          "effect/http/HttpClientRequest#bodyJsonUnsafe",
          "effect/http/HttpClientRequest#bodyUint8Array",
          "effect/http/HttpClientRequest#bodyUrlParams",
          "effect/http/HttpClientRequest#delete",
          "effect/http/HttpClientRequest#get",
          "effect/http/HttpClientRequest#post",
          "effect/http/HttpClientRequest#prependUrl",
          "effect/http/HttpClientRequest#put",
          "effect/http/HttpClientRequest#schemaBodyJson",
          "effect/http/HttpClientRequest#toWeb",
          "effect/http/HttpClientResponse#HttpClientResponse",
          "effect/http/HttpClientResponse#fromWeb",
          "effect/http/HttpClientResponse#schemaBodyJson",
          "effect/http/HttpIncomingMessage#schemaBodyJson",
          "effect/http/HttpServer#formatAddress",
          "effect/http/HttpServerRequest#HttpServerRequest",
          "effect/http/HttpServerResponse#HttpServerResponse",
          "effect/http/HttpServerResponse#empty",
          "effect/http/HttpServerResponse#text",
          "effect/http/UrlParams#toString",
          "effect/process/ChildProcess#CommandInput",
          "effect/process/ChildProcess#make",
          "effect/process/ChildProcessSpawner#ChildProcessSpawner"
        ]
      }
    ]
  }
}
