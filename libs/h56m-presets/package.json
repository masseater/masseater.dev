{
  "name": "@r_masseater/h56m-presets",
  "version": "0.1.0",
  "description": "Ready-made rule presets for the h56m secret scanner, starting with the default Betterleaks rules.",
  "keywords": [
    "betterleaks",
    "gitleaks",
    "h56m",
    "preset",
    "secrets",
    "security",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/masseater/masseater.dev/tree/main/libs/h56m-presets#readme",
  "bugs": {
    "url": "https://github.com/masseater/masseater.dev/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/masseater.dev.git",
    "directory": "libs/h56m-presets"
  },
  "files": [
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "dist",
    "presets",
    "skills/use-presets"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./presets/*": "./presets/*",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build",
    "prepare": "node bin/extract.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@r_masseater/h56m": "workspace:*",
    "@r_masseater/vitest-otlp": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "@r_masseater/h56m": "^0.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}
