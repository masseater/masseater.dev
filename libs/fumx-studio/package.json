{
  "name": "@masseater.dev/fumx-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Renders a .fumx song in the browser into per-track stems and a mastered mix for daw-view, with the DSP every song shares.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./worklet": "./src/app/worklet.ts",
    "./parts-worker": "./src/app/parts-worker.ts",
    "./daw/*": "./src/shared/lib/daw/*.ts",
    "./dsp/*": "./src/shared/lib/dsp/*.ts",
    "./live/*": "./src/shared/lib/live/*.ts",
    "./plugin/*": "./src/shared/lib/plugin/*.ts",
    "./studio/*": "./src/shared/lib/studio/*.ts"
  },
  "dependencies": {
    "@masseater.dev/daw-view": "workspace:*",
    "@r_masseater/song-format": "catalog:",
    "effect": "catalog:stack",
    "tonal": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@r_masseater/vitest-otlp": "catalog:",
    "lapse": "workspace:*",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  }
}
