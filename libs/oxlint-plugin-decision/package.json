{
  "name": "@r_masseater/oxlint-plugin-decision",
  "version": "0.6.0",
  "description": "Oxlint JS plugin that lints code with plain-English rules answered by models on Cloudflare AI Gateway or decision models on OpenRouter.",
  "keywords": [
    "ai-gateway",
    "cloudflare",
    "decision-model",
    "lint",
    "openrouter",
    "oxlint",
    "oxlint-plugin",
    "preset",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/masseater/masseater.dev/tree/main/libs/oxlint-plugin-decision#readme",
  "bugs": {
    "url": "https://github.com/masseater/masseater.dev/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/masseater.dev.git",
    "directory": "libs/oxlint-plugin-decision"
  },
  "files": [
    "dist",
    "skills/write-decision-rules"
  ],
  "type": "module",
  "imports": {
    "#example-presets/*": "./example-presets/*",
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/index.ts",
    "./openrouter-app": "./src/app/openrouter-app.ts",
    "./presets": "./src/app/presets.ts",
    "./presets/recommended": "./src/app/recommended.ts",
    "./presets/strict": "./src/app/strict.ts",
    "./presets/review-only": "./src/app/review-only.ts",
    "./presets/ai-slop": "./src/app/ai-slop.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./openrouter-app": {
        "types": "./dist/openrouter-app.d.mts",
        "default": "./dist/openrouter-app.mjs"
      },
      "./presets": {
        "types": "./dist/presets/index.d.mts",
        "default": "./dist/presets/index.mjs"
      },
      "./presets/recommended": {
        "types": "./dist/presets/recommended.d.mts",
        "default": "./dist/presets/recommended.mjs"
      },
      "./presets/strict": {
        "types": "./dist/presets/strict.d.mts",
        "default": "./dist/presets/strict.mjs"
      },
      "./presets/review-only": {
        "types": "./dist/presets/review-only.d.mts",
        "default": "./dist/presets/review-only.mjs"
      },
      "./presets/ai-slop": {
        "types": "./dist/presets/ai-slop.d.mts",
        "default": "./dist/presets/ai-slop.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/ai-openrouter": "catalog:",
    "synckit": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:stack",
    "oxlint": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "@effect/platform-node-shared": "^4.1.2",
    "effect": "^4.1.2",
    "oxlint": ">=1.87.0"
  },
  "engines": {
    "node": ">=26"
  }
}
