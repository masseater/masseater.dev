{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/plugin-schema.json",
  "name": "masseater-scripts",
  "detection": { "type": "fileExists", "pattern": "pnpm-workspace.yaml" },
  "entryPoints": [
    "apps/portfolio/scripts/standard-site.ts",
    "apps/medley-manager/auth.config.ts",
    "apps/watashi-mcp/auth.config.ts",
    "apps/aredoko-server/src/app/fetch-model.ts",
    "tools/pod-rattle-parity/extract.ts",
    "tools/pod-rattle-parity/render.ts",
    "tools/decision-bench-runner/src/run.ts",
    "tools/decision-bench-runner/src/build-jnli.ts",
    "tools/decision-bench-runner/src/build-rules.ts",
    "infra/start-site/src/write-asset-headers.ts",
    "tools/ocr-ja-bench/src/render.ts",
    "tools/ocr-ja-bench/src/measure.ts",
    "tools/ocr-ja-bench/src/rescore.ts",
    "tools/ocr-measure/src/render.ts",
    "tools/ocr-measure/src/measure.ts",
    "tools/ocr-measure/src/rescore.ts",
    "tools/injection-bisect-cli/src/main.ts",
  ],
  "entryPointRole": "runtime",
}
