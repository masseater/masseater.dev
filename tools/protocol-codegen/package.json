    "@masseater.dev/shirushi-protocol": "workspace:*",
    "@masseater.dev/sts2-protocol": "workspace:*",
    "@masseater.dev/yogoto-protocol": "workspace:*",
    "@masseater.dev/yohaku-protocol": "workspace:*",
    "@r_masseater/node-main": "catalog:",
    "effect": "catalog:stack",
    "quicktype-core": "26.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:stack"
  }
