{
  "name": "masseater.dev",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint && msch --prepare"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:stack",
    "@r_masseater/msch": "workspace:*",
    "@r_masseater/workers-tracing": "workspace:*",
    "@tanstack/intent": "catalog:",
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "effect": "catalog:stack",
    "fallow": "catalog:stack",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "intent": {
    "skills": [
      "@tanstack/devtools-vite",
      "@tanstack/react-start",
      "drizzle-kit",
      "@tanstack/devtools",
      "@tanstack/devtools-event-client",
      "@tanstack/match-sorter-utils",
      "@tanstack/router-core",
      "@tanstack/start-client-core",
      "@tanstack/virtual-file-routes",
      "@tanstack/router-plugin",
      "@tanstack/start-server-core",
      "fallow",
      "workspace:@masseater.dev/effect2rs",
      "workspace:@r_masseater/msch"
    ]
  }
}
