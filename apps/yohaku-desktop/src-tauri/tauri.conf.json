{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "余白",
  "version": "0.1.1",
  "identifier": "dev.masseater.yohaku",
  "build": {
    "beforeDevCommand": "vp dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "vp build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "余白",
        "width": 1280,
        "height": 860
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "masseater",
    "shortDescription": "書くことに集中する小説のエディタ",
    "copyright": "© masseater"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0OTUxMDRDMUU2MUI0OUQKUldTZHRHRWVUQkNWRklwQXpORzZIMXFXcjl4THpYM1VuUG1mYUVPbXo4SnQ5NFpwbW5EdmFuQWEK",
      "endpoints": [
        "https://github.com/masseater/masseater.dev/releases/download/yohaku-updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
