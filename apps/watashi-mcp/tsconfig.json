{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "../../tsconfig.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node/NodeServices#layer",
          "@effect/sql-sqlite-node/SqliteClient",
          "@effect/vitest#it",
          "effect/FileSystem#FileSystem",
          "effect/Path#Path",
          "effect/PlatformError#PlatformError",
          "effect/http/FetchHttpClient",
          "effect/http/HttpClient",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/sql/SqlClient",
          "effect/sql/SqlError"
        ]
      }
    ],
    "types": ["vite/client", "@cloudflare/workers-types"],
    "paths": {
      "#/*": ["./src/*"]
    }
  }
}
