{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, served from the app or from the bundled localhost server",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-list-songs",
    "allow-song-folder",
    "allow-remove-song",
    "allow-list-models",
    "allow-list-jobs",
    "allow-import-song",
    "allow-separate-song",
    "allow-analyze-song",
    "allow-choose-audio-files",
    "allow-mcp-access"
  ]
}
