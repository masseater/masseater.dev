{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "#/*": ["./src/*"],
      "typescript": ["./node_modules/typescript-6"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node/NodeServices#layer",
          "effect/FileSystem#FileSystem",
          "effect/Path#Path",
          "@effect/atom-react",
          "effect/reactivity/Atom"
        ]
      }
    ],
    "allowArbitraryExtensions": true
  },
  "contentMappers": [
    {
      "package": "rpp-kit",
      "extensions": [".rpp"]
    }
  ]
}
