{
  "name": "aredoko-server",
  "version": "0.0.0",
  "private": true,
  "description": "aredoko search server on the Unity PC: indexes the user's assets with image embeddings and answers searches from the Unity editor extension.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/app/main.ts",
    "./embedder-worker": "./src/app/embedder-worker.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@huggingface/transformers": "catalog:stack",
    "@masseater.dev/aredoko-protocol": "workspace:*",
    "@masseater.dev/local-server": "workspace:*",
    "@r_masseater/node-main": "catalog:",
    "@zip.js/zip.js": "catalog:",
    "effect": "catalog:stack",
    "fzstd": "catalog:",
    "sharp": "catalog:",
    "sqlite-vec": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  }
}
