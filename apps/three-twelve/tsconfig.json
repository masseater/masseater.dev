{
  "extends": "../../tsconfig.json",
  "include": ["*.ts", "worker/*.ts", "player/*.ts"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/http/FetchHttpClient",
          "effect/http/HttpClient",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/Stdio",
          "@effect/platform-node/NodeRuntime",
          "@effect/platform-node/NodeServices",
          "@effect/platform-node-shared/NodeStream"
        ]
      }
    ],
    "types": ["node", "@cloudflare/workers-types"]
  }
}
