{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yakusu",
  "version": "0.1.0",
  "identifier": "dev.masseater.yakusu",
  "build": {
    "beforeDevCommand": "vp dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "vp build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yakusu",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "masseater",
    "shortDescription": "PLaMo 3 Translate で手元だけで訳す",
    "copyright": "© masseater"
  }
}
