{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, served from the app or from the bundled localhost server",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:default",
    "allow-list-comments",
    "allow-save-comment",
    "allow-remove-comment",
    "allow-restore-comment",
    "allow-open-link",
    "allow-open-file",
    "allow-choose-file",
    "allow-mcp-access"
  ]
}
