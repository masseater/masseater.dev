{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "extends": "../../tsconfig.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@cloudflare/workers-types", "@webgpu/types"],
    "paths": {
      "#/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/atom-react",
          "@effect/platform-node/NodeRuntime#runMain",
          "@effect/platform-node/NodeServices#layer",
          "@effect/vitest#layer",
          "effect/FileSystem#FileSystem",
          "effect/Path#Path",
          "effect/process/ChildProcess#make",
          "effect/reactivity/Atom",
          "effect/http/FetchHttpClient#layer",
          "effect/http/HttpClient#get",
          "effect/http/HttpClient#HttpClient",
          "effect/http/HttpClientError#HttpClientError",
          "effect/http/HttpClientResponse#filterStatusOk",
          "effect/http/HttpClientResponse#schemaBodyJson"
        ]
      }
    ]
  }
}
