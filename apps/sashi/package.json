{
  "name": "sashi",
  "version": "0.0.0",
  "private": true,
  "description": "sashi.masseater.dev, a static site where the owner collects and publishes the references that stand in for what they want.",
  "bin": {
    "write-site": "./bin/write-site.ts"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
