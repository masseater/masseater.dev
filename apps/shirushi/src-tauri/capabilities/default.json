{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, served from the app or from the bundled localhost server",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-list-marks",
    "allow-save-mark",
    "allow-remove-mark",
    "allow-get-still",
    "allow-list-pairs",
    "allow-choose-pair",
    "allow-list-statements",
    "allow-judge-statement",
    "allow-list-forecasts",
    "allow-open-link",
    "allow-open-file",
    "allow-choose-file",
    "allow-mcp-access"
  ]
}
