{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "しるし",
  "identifier": "dev.masseater.shirushi",
  "build": {
    "beforeDevCommand": "vp dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "vp build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "しるし",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com https://w.soundcloud.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://w.soundcloud.com https://embed.nicovideo.jp; img-src 'self' data: https:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "masseater",
    "shortDescription": "曲や動画の好きな所にしるしを付けて、作品を作る AI に渡す",
    "copyright": "© masseater",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczMTQ0Q0JBODEwOTJGNTkKUldSWkx3bUJ1a3dVYzVoa0N3MHhDYUExeXlnWm1uUnUvUTl4RkxqeCthbWR4VkdnWjU2d0w5T0UK",
      "endpoints": [
        "https://github.com/masseater/masseater.dev/releases/download/shirushi-updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
