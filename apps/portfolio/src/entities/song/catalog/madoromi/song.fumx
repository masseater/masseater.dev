  "samples/fm_56.flac" root Ab3
  "samples/fm_60.flac" root C4
  "samples/fm_64.flac" root E4
  "samples/fm_68.flac" root Ab4
}
instrument bass sample "samples/b_sub.flac" root C2

bus plate volume -4dB fx [highpass 300Hz, reverb ir "samples/irL.flac" "samples/irR.flac" predelay 20ms, gain -25dB]

track vocal instrument voice role melody volume -10dB send plate 35%
track piano instrument piano role harmony volume -16dB send plate 25%
track bass  instrument bass role bass volume -9dB
track drums kit kit volume -11dB send plate 8%

master fx [limit -1dB]
