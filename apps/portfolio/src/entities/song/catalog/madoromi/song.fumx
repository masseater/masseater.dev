song "まどろみの窓"

kit kit {
  kick  "samples/k1.flac"
  snare "samples/sn1.flac" gain -3dB
  hat   "samples/ch1.flac" gain -12dB
}
instrument voice multisample {
  "samples/org_69.flac" root A3
  "samples/org_72.flac" root C4
  "samples/org_75.flac" root Eb4
  "samples/org_78.flac" root Gb4
  "samples/org_81.flac" root A4
  "samples/org_84.flac" root C5
}
