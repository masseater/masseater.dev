{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "alchemy dev",
    "typecheck": "tsc",
    "test": "vp test run --fsModuleCachePath node_modules/.vitest-cache --passWithNoTests",
    "steiger": "steiger ./src",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "fallow": "fallow --skip dupes --fail-on-issues --quiet --format compact && fallow dupes --fail-on-issues --quiet --format compact && fallow security --fail-on-issues --quiet",
    "deploy": "alchemy deploy",
    "deploy:github": "alchemy deploy --config alchemy.github.ts --stage prod --yes",
    "tokens": "vpx cloudflare-tokens.ts",
    "destroy": "alchemy destroy",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && drizzle-kit generate --explain --output json | grep -q '\"status\":\"no_changes\"'"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare": "catalog:stack",
    "@distilled.cloud/github": "catalog:",
    "@effect/atom-react": "catalog:stack",
    "@elysiajs/eden": "catalog:stack",
    "@masseater.dev/alchemy-app-name": "workspace:*",
    "@masseater.dev/ui": "workspace:*",
