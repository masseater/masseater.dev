{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "alchemy dev",
    "typecheck": "tsc",
    "test": "vp test run --passWithNoTests",
    "steiger": "steiger ./src",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "fallow": "fallow --skip dupes --fail-on-issues --quiet --format compact && fallow dupes --fail-on-issues --quiet --format compact && fallow security --fail-on-issues --quiet",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && drizzle-kit generate --explain --output json | grep -q '\"status\":\"no_changes\"'"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:stack",
    "@elysiajs/eden": "catalog:stack",
    "@masseater.dev/ui": "workspace:*",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "catalog:stack",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "cn": "catalog:",
    "drizzle-orm": "catalog:stack",
    "eden-tanstack-react-query": "catalog:stack",
    "effect": "catalog:stack",
    "elysia": "catalog:stack",
    "feed": "catalog:",
    "jose": "catalog:",
    "radix-ui": "catalog:",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scheduler": "0.28.0",
    "tailwindcss": "catalog:stack"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/tsgo": "catalog:stack",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@mdx-js/rollup": "catalog:",
    "@shikijs/rehype": "catalog:",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-start": "catalog:stack",
    "@types/hast": "catalog:",
    "@types/mdx": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "alchemy": "catalog:stack",
    "drizzle-kit": "catalog:stack",
    "mdast-util-mdx-jsx": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-gfm": "catalog:",
    "remark-mdx-frontmatter": "catalog:",
    "steiger": "catalog:stack",
    "typescript": "catalog:stack",
    "vite": "catalog:",
    "vite-plus": "catalog:stack"
  }
}
