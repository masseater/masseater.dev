{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ふし",
  "identifier": "dev.masseater.fushi",
  "build": {
    "beforeDevCommand": "vp dev",
    "devUrl": "http://localhost:1470",
    "beforeBuildCommand": "vp build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "ふし",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost otlp: http://otlp.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "masseater",
    "shortDescription": "曲から作風の癖を見つけて i68 のルールにする",
    "copyright": "© masseater",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese"]
      }
    }
  }
}
