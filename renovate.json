{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    ":semanticCommits",
    "group:allNonMajor",
    "github>masseater/ecosystems//libs/vite-plus-adopt/renovate",
    "github>masseater/ecosystems//libs/msch/renovate"
  ],
  "automerge": true,
  "configMigration": true,
  "ignoreTests": true,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchPackageNames": [
        "effect",
        "@effect/**",
        "!@effect/tsgo",
        "alchemy",
        "@alchemy.run/**",
        "@distilled.cloud/**"
      ],
      "groupName": "effect and alchemy"
    },
    {
      "description": "textlint と @textlint/* は同じ版の型を互いに渡す。1 つずつ上げると型が合わずに check が落ちる（#1421・#1422）。",
      "matchPackageNames": ["textlint", "@textlint/**"],
      "groupName": "textlint"
    },
    {
      "description": "@better-auth/* は ^ の peer で最新の @better-auth/core を取り、better-auth は自分の版の core に固定する。1 つずつ上げると core が 2 つ入り、OwnerAuthOptions が BetterAuthOptions に合わずに check が落ちる (#1482)。",
      "matchPackageNames": ["better-auth", "@better-auth/**", "auth"],
      "groupName": "better-auth"
    },
    {
      "description": "vite-plus は oxlint と tsrs の版を固定し（tsrs はルートの devDependencies にも入れてあり、oxlint と同時に上げる）、@effect/tsgo は対応している版の oxlint と tsrs にしかパッチを当てられない。合わないと prepare が落ちて vp install が失敗する。vite-plus は vitest の版も固定し、@vitest/* だけが上がると vitest が 2 つ入って @effect/vitest のテストが suite を見つけられずに落ちる (#1479)。組で上げ、up-to-date の install が通ったときだけマージする。",
      "matchPackageNames": [
        "vite-plus",
        "oxlint",
        "@oxlint/plugins",
        "@effect/tsgo",
        "oxlint-tsgolint",
        "oxlint-plugin-eslint",
        "tsrs",
        "vitest",
        "@vitest/**"
      ],
      "groupName": "oxlint and effect-tsgo",
      "ignoreTests": false
    },
    {
      "description": "patches/ の crate はルートの Cargo.lock で解決される。Renovate は写しの Cargo.toml と写し自身の Cargo.lock だけを上げ、ルートの Cargo.lock と食い違って cargo の --locked が落ちる (#1283, #1284, #1289)。更新しない。",
      "matchFileNames": ["patches/**"],
      "enabled": false
    },
    {
      "description": "テストの fixtures は外部ツールの出力と突き合わせる写しで、版を上げると記録した結果と食い違う (#1399, #1401, #1405, #1406)。更新しない。",
      "matchFileNames": ["**/fixtures/**"],
      "enabled": false
    },
    {
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@bufbuild/protobuf", "@bufbuild/protoc-gen-es"],
      "groupName": "protobuf-es"
    },
    {
      "description": "gungraun は同じ版の gungraun-runner でしか動かない。runner は tools/cargo-tools で別の Cargo.lock に固定しているので、組で上げる。",
      "matchPackageNames": ["gungraun", "gungraun-runner"],
      "groupName": "gungraun"
    },
    {
      "matchPackageNames": ["@paper-design/**"],
      "groupName": "paper shaders"
    },
    {
      "matchPackageNames": ["typescript"],
      "matchDepNames": ["!typescript-wasm"],
      "allowedVersions": "/^(?:[7-9]|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+(?:-(?:beta|rc)[0-9.]*)?$/"
    },
    {
      "matchDepNames": ["typescript-wasm", "@typescript/typescript-wasip1-wasm"],
      "followTag": "next",
      "groupName": "typescript wasm"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["masseater/typescript-template"],
      "enabled": false
    },
    {
      "description": "公開日時の無い種類の更新は待機期間を判定できず、掛けると止まったままになるので外す。",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "replacement",
        "pin",
        "bump",
        "lockfileUpdate",
        "rollback"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "公開日時を返さないデータソースは待機期間を判定できず、掛けると止まったままになるので外す。",
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": null
    },
    {
      "description": "持ち主自身のリポジトリは待たせない。",
      "matchDepNames": ["masseater/**"],
      "minimumReleaseAge": null
    },
    {
      "description": "masseater/skills と masseater/typescript-template はマージのたびに全リポへ digest の PR を出し、ジョブの同時実行枠を埋める。1 日 1 回にまとめる。",
      "matchDepNames": ["masseater/skills", "masseater/typescript-template"],
      "groupName": "masseater digests",
      "schedule": ["* 4 * * *"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.claude/settings\\.json$/"],
      "matchStrings": [
        "\"repo\": \"(?<depName>masseater/cc-jev-teacher)\",\\s+\"ref\": \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "currentValueTemplate": "main",
      "packageNameTemplate": "https://github.com/{{depName}}",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)buf\\.gen\\.yaml$/"],
      "matchStrings": ["remote: buf\\.build/bufbuild/es:v(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "@bufbuild/protoc-gen-es",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: (?<depName>masseater/typescript-template)/\\.github/actions/[a-z-]+@(?<currentDigest>[0-9a-f]{40})"
      ],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.claude/hooks/session-start\\.sh$/"],
      "matchStrings": ["MISE_VERSION=(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases"
    }
  ],
  "rollbackPrs": false,
  "timezone": "Asia/Tokyo"
}
