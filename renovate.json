{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "automerge": true,
  "ignoreTests": true,
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchPackageNames": [
        "effect",
        "@effect/**",
        "!@effect/tsgo",
        "alchemy",
        "@alchemy.run/**",
        "@distilled.cloud/**"
      ],
      "groupName": "effect and alchemy"
    },
    {
      "description": "@effect/tsgo は対応している版の oxlint にしかパッチを当てられず、合わないと prepare が落ちて vp install が失敗する。組で上げ、pr-title の install が通ったときだけマージする。",
      "matchPackageNames": ["oxlint", "@oxlint/plugins", "@effect/tsgo"],
      "groupName": "oxlint and effect-tsgo",
      "ignoreTests": false
    },
    {
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "minihost の wheel は Python 3.14 までしか無く、3.15 にすると uv が依存を解けず pod-rattle ワークフローが落ちる。",
      "matchFileNames": ["tools/pod-rattle-host/pyproject.toml"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    },
    {
      "matchPackageNames": ["@bufbuild/protobuf", "@bufbuild/protoc-gen-es"],
      "groupName": "protobuf-es"
    },
    {
      "matchPackageNames": ["@paper-design/**"],
      "groupName": "paper shaders"
    },
    {
      "matchPackageNames": ["typescript"],
      "matchDepNames": ["!typescript-wasm"],
      "allowedVersions": "/^(?:[7-9]|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+(?:-(?:beta|rc)[0-9.]*)?$/"
    },
    {
      "matchDepNames": ["typescript-wasm", "@typescript/typescript-wasip1-wasm"],
      "followTag": "next",
      "groupName": "typescript wasm"
    },
    {
      "matchFileNames": ["skills-lock.json"],
      "ignoreTests": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["masseater/typescript-template"],
      "enabled": false
    },
    {
      "description": "公開日時の無い種類の更新は待機期間を判定できず、掛けると止まったままになるので外す。",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "replacement",
        "pin",
        "bump",
        "lockfileUpdate",
        "rollback"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "公開日時を返さないデータソースは待機期間を判定できず、掛けると止まったままになるので外す。",
      "matchDatasources": ["git-refs", "python-version"],
      "minimumReleaseAge": null
    },
    {
      "description": "持ち主自身のリポジトリは待たせない。",
      "matchDepNames": ["masseater/**"],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)buf\\.gen\\.yaml$/"],
      "matchStrings": ["remote: buf\\.build/bufbuild/es:v(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "@bufbuild/protoc-gen-es",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^skills-lock\\.json$/"],
      "matchStrings": [
        "\"source\": \"(?<depName>[^\"]+)\",\\s*\"ref\": \"(?<currentDigest>[0-9a-f]{40})\",\\s*\"sourceType\": \"github\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: (?<depName>masseater/typescript-template)/\\.github/actions/[a-z-]+@(?<currentDigest>[0-9a-f]{40})"
      ],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "rollbackPrs": false
}
